# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Your Anthropic API key — powers the main tutor chat (src/app/api/tutor/route.ts).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your Google AI Studio API key — still required. MCQ generation, FRQ generation/grading,
# Source/DBQ generation/grading, oral grading, session summaries, and the mentor tip
# all still call Gemini directly (see note in README about provider swap scope).
# Get one at https://aistudio.google.com/
# Restrict the key to your deployment domain in the Google Cloud Console.
GEMINI_API_KEY=your_gemini_api_key_here

# Classroom access code(s) — students enter this to access the app.
# Use a comma-separated list for multiple valid codes: code1,code2,code3
# This is NOT strong security — it is a lightweight access gate only.
CLASSROOM_CODE=your_classroom_code_here
