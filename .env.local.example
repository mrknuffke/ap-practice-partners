# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Your Google AI Studio API key
# Get one at https://aistudio.google.com/
# Restrict the key to your deployment domain in the Google Cloud Console.
GEMINI_API_KEY=your_gemini_api_key_here

# Auth.js secret (generate with: openssl rand -base64 32 or npx auth secret)
AUTH_SECRET=your_auth_secret_here

# Google OAuth credentials (from Google Cloud Console)
# Redirect URI to configure in Google Cloud:
# Development: http://localhost:3000/api/auth/callback/google
# Production: https://your-deployment-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Restrict Google sign-in to this Google Workspace domain (e.g. sas.edu.sg)
# Leave blank to allow any Google account.
ALLOWED_DOMAIN=sas.edu.sg

# (Optional) Override the default Gemini model for all API routes.
# Default is gemini-3.5-flash. All routes read from src/lib/ai-config.ts.
# GEMINI_MODEL=gemini-3.5-flash
